# Copy this to  .env  in the project root and fill it in.  NEVER commit .env.

# Port the API server listens on (localhost only; nginx proxies to it).
PORT=8787

# Where the single shared SQLite database lives. Use an ABSOLUTE path in production
# and make sure the directory is writable by the service user. Back this file up.
DB_PATH=/opt/baby-tracker/data/baby-tracker.sqlite3

# Secret used to sign session cookies. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out.
SESSION_SECRET=

# Accounts, family-tagged. Generate each entry with:
#   npm run hash-password <name> <password>
# then replace FAMILY in the printed line with a family key, and paste them here
# comma-separated (NO spaces around the comma). Accounts sharing a family key share
# the same data (babies, entries, settings); different families are fully isolated.
#   BT_USERS=andres:family=lopez:scrypt$salt$hash,maria:family=lopez:scrypt$salt$hash,otherparent:family=nunez:scrypt$salt$hash
BT_USERS=

# Which family existing (pre-families) data migrates onto, on first boot against an
# older database. Defaults to the first family listed in BT_USERS. Only matters once,
# on upgrade; harmless to leave unset for a fresh install.
# LEGACY_FAMILY=lopez

# Restricts whole-database backup export/import (Settings → Backup) to this one
# family. Recommended once you host more than one family on the same server, so one
# family can't download or overwrite another's data. Leave unset to allow any signed-in
# user to export/import (fine for a single-family deployment).
# ADMIN_FAMILY=lopez

# Marks cookies Secure (HTTPS-only). Keep this for any real deployment.
NODE_ENV=production

# Optional: let Node serve the built static app itself instead of nginx.
# Leave unset if nginx serves ./dist directly (recommended, see DEPLOY.md).
# STATIC_DIR=/opt/baby-tracker/dist
